# Configuración de la base de datos MySQL local
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sagsa_pwa
DB_USER=root
DB_PASSWORD=tu_contraseña_de_mysql

# Puerto del servidor backend
PORT=4000

# Clave secreta para firmar los tokens JWT (usa un texto largo y aleatorio)
JWT_SECRET=cambia_esto_por_una_frase_larga_y_secreta
JWT_EXPIRES_IN=8h

# Envío de correo (Gmail SMTP vía Nodemailer). EMAIL_PASS es una
# "contraseña de aplicación" de Gmail, no la contraseña normal de la cuenta.
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=tu_contraseña_de_aplicacion_de_gmail

# URL base del frontend, usada para construir el enlace de recuperación de contraseña
FRONTEND_URL=http://localhost:5173

# Administrador master (seed inicial, ver: npm run seed)
MASTER_ADMIN_NOMBRE=Administrador Sagsa
MASTER_ADMIN_CORREO=admin@sagsa.edu.gt
MASTER_ADMIN_PASSWORD=cambia_esto_por_una_contraseña_segura
MASTER_ADMIN_DPI=1234567890101
